# The upload page's folder: only index.php can be opened; lib.php and page.php are parts of it.
Options -Indexes
DirectoryIndex index.php

<FilesMatch ".">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
