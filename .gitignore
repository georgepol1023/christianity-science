# Large media: kept on the web host, not in git (20 GB of mp3, ~200 MB of PDFs)…
mp3/**
files/**
# …but the few web pages among them are kept, so that every copy (GitHub's too) builds the same English pages
!mp3/**/
!files/**/
!mp3/**/*.htm
!files/**/*.htm
# …but the English pages made from the pages in mp3/ belong to the site (tools/build_en.py)
!en/mp3/
en/mp3/**/*.mp3

# Tooling
node_modules/
tests/node_modules/
*.part

# Working files of the translation tools
translation/_*
__pycache__/
